apiVersion: kustomize.config.k8s.io/v1beta1
kind: Kustomization

helmCharts:
- name: azuredisk-csi-driver
  repo: https://raw.githubusercontent.com/kubernetes-sigs/azuredisk-csi-driver/v1.36.1/charts
  version: v1.36.1
  releaseName: azuredisk-csi-driver
  namespace: kube-system
  valuesFile: helm-values

patches:
  - patch: |-
      apiVersion: apps/v1
      kind: DaemonSet
      metadata:
        name: csi-azuredisk-node
        namespace: kube-system
      spec:
        template:
          spec:
            containers:
              - name: liveness-probe
                image: '{{ .InternalImages.Get "AzureDiskCSILivenessProbe" }}'
              - name: node-driver-registrar
                image: '{{ .InternalImages.Get "AzureDiskCSINodeDriverRegistar" }}'
              - name: azuredisk
                image: '{{ .InternalImages.Get "AzureDiskCSI" }}'
  - patch: |-
      apiVersion: apps/v1
      kind: Deployment
      metadata:
        name: csi-azuredisk-controller
        namespace: kube-system
      spec:
        template:
          spec:
            containers:
              - name: csi-provisioner
                image: '{{ .InternalImages.Get "AzureDiskCSIProvisioner" }}'
              - name: csi-attacher
                image: '{{ .InternalImages.Get "AzureDiskCSIAttacher" }}'
              - name: csi-snapshotter
                image: '{{ .InternalImages.Get "AzureDiskCSISnapshotter" }}'
              - name: csi-resizer
                image: '{{ .InternalImages.Get "AzureDiskCSIResizer" }}'
              - name: liveness-probe
                image: '{{ .InternalImages.Get "AzureDiskCSILivenessProbe" }}'
              - name: azuredisk
                image: '{{ .InternalImages.Get "AzureDiskCSI" }}'
  # upstream names the node-driver-registrar port "healthz", clashing with the azuredisk container port
  - target:
      kind: DaemonSet
      name: csi-azuredisk-node
    patch: |-
      - op: test
        path: /spec/template/spec/containers/1/name
        value: node-driver-registrar
      - op: replace
        path: /spec/template/spec/containers/1/ports/0/name
        value: healthz-reg
      - op: replace
        path: /spec/template/spec/containers/1/livenessProbe/httpGet/port
        value: healthz-reg
