apiVersion: kustomize.config.k8s.io/v1beta1
kind: Kustomization
namespace: kube-system

helmCharts:
- name: hcloud-cloud-controller-manager
  repo: https://charts.hetzner.cloud
  version: 1.39.1
  releaseName: hccm
  namespace: kube-system
  valuesFile: generate-values-ccm

patches:
  - patch: |-
      apiVersion: apps/v1
      kind: Deployment
      metadata:
        name: hcloud-cloud-controller-manager
        namespace: kube-system
      spec:
        template:
          metadata:
            annotations:
              kubeone.k8c.io/credentials-hash: '{{ .CredentialsCCMHash }}'
          spec:
            # hostNetwork so DNS lookups (e.g. api.hetzner.cloud) go out over
            # the node's real interfaces instead of the CNI pod network, which
            # may be IPv4-only while the node's resolv.conf only has IPv6
            # resolvers.
            hostNetwork: true
            containers:
              - name: hcloud-cloud-controller-manager
                image: '{{ .InternalImages.Get "HetznerCCM" }}'
  - target:
      kind: Deployment
      name: hcloud-cloud-controller-manager
    patch: |-
      - op: add
        path: /spec/template/spec/containers/0/args/-
        value: '--concurrent-service-syncs={{ default 1 .Params.CCM_CONCURRENT_SERVICE_SYNCS }}'
      - op: add
        path: /spec/template/spec/containers/0/env/-
        value:
          name: HCLOUD_LOAD_BALANCERS_USE_PRIVATE_IP
          value: '{{ if .Config.CloudProvider.Hetzner.NetworkID }}true{{ else }}false{{ end }}'
      - op: add
        path: /spec/template/spec/containers/0/env/-
        value:
          name: HCLOUD_NETWORK
          value: '{{ .Config.CloudProvider.Hetzner.NetworkID }}'
